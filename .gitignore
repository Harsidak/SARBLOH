# --- Third-party material: catalogued in resources/INDEX.md, not redistributed ---
resources/papers/**
resources/repos/
resources/web/
!resources/papers/**/
!resources/papers/**/*.meta.yaml
scripts/Games/
Alignment/authoring/scripts/

# --- Kaggle workspace: notebooks are public; weights, staging and third-party code are not ---
kaggle/.push/
kaggle/datasets/models/
kaggle/datasets/Taaf agent/
kaggle/datasets/sarbloh-agent/sarbloh/
kaggle/datasets/*/*.whl
kaggle/reference/

# --- Local inference binaries ---
tools/

# --- Large binaries ---
*.gguf
*.pkl
*.npz
*.pt
*.safetensors

# --- Internal notes and unattributed results ---
history/legacy_scores/
planning/SESSION_CONTEXT.md
planning/GIT_SETUP.md
planning/MIGRATION.md
experiments_*.md

# --- OS / editor / local agent tooling ---
